<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The link code may give an http:// address (e.g. the web app on the
         pharmacy's own network). Android blocks plain http by default, which
         showed up as "Could not reach the web app", so allow it. https is
         still used whenever the link code gives an https address. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
